# Copy to .env.local and fill in. `.env.local` is gitignored; this file is not.
# Nothing here is read by the browser — the enquiry mail runs server-side only.

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Required. Without all four, the enquiry form tells the visitor it could not
# send and shows the phone numbers instead — it never pretends to have sent.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below
# (spaces are fine). A normal account password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shreyahighrise@gmail.com
SMTP_PASS=

# ── Addresses ─────────────────────────────────────────────────────────────────
# All optional. Set one only to override the default shown after the "=".

# Envelope sender. Gmail rewrites anything that is not the authenticated account,
# so leave this unset unless the provider allows a different From. (= SMTP_USER)
EMAIL_FROM=

# Where enquiries land. Defaults come from `site.emails` in src/data/site.ts.
EMAIL_TO_SALES=
EMAIL_TO_PROJECTS=
